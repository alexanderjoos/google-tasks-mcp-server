{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "google-tasks-mcp-server",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-19",
  // MCP SDK が Node 互換 API を参照するため有効化する
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "642465aa1d6046d0a17708f64b8180bf"
    }
  ],
  "vars": {
    // GOOGLE_CLIENT_SECRET は vars ではなく `wrangler secret put` で設定する
    "GOOGLE_CLIENT_ID": "723034496442-cmkbnv402c183pd2dah3lkgap1n5nkno.apps.googleusercontent.com",
    "ALLOWED_EMAIL": "REDACTED_EMAIL"
  }
}
