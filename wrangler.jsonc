{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtasks-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
    // The MCP SDK references a few Node-compatible APIs.
    "nodejs_compat",
    // Required by workers-oauth-provider for Client ID Metadata Documents (SSRF protection).
    "global_fetch_strictly_public"
  ],
  "observability": { "enabled": true },
  "dev": { "port": 8788 },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Create with: npx wrangler kv namespace create OAUTH_KV
      "id": "8cd73e4c3f87445cb8da1f0ac5b99e03"
    }
  ],
  "vars": {
    // Hosts that MCP clients may redirect back to after authorization.
    // Anything else is rejected, so a third party can't register a client and phish a token.
    "ALLOWED_REDIRECT_HOSTS": "claude.ai,claude.com,localhost,127.0.0.1",
    // Default time zone for new spreadsheets (and Canvas due dates).
    "TIME_ZONE": "America/New_York"
  }
  // Secrets (never commit these; use `npx wrangler secret put <NAME>` or .dev.vars locally):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ALLOWED_EMAIL, TASKS_ACCOUNT (optional)
}
